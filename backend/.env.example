# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. ^https://personaverse(-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# LLM provider for personas: auto | gemini | openai | none
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Limits
MAX_UPLOAD_MB=20
MAX_ROWS=200000
SESSION_TTL_MINUTES=120
MAX_SESSIONS=50
